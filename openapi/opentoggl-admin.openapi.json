{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenToggl Instance Admin API",
    "version": "0.1.0"
  },
  "paths": {
    "/admin/v1/bootstrap": {
      "get": {
        "summary": "Get current bootstrap state",
        "operationId": "get-bootstrap-state",
        "responses": {
          "200": {
            "description": "Bootstrap state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapState"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create the first instance administrator",
        "operationId": "bootstrap-instance-admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bootstrap completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapState"
                }
              }
            }
          },
          "409": {
            "description": "Bootstrap already completed"
          }
        }
      }
    },
    "/admin/v1/registration-policy": {
      "get": {
        "summary": "Get current registration policy",
        "operationId": "get-registration-policy",
        "responses": {
          "200": {
            "description": "Current registration policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationPolicy"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update registration policy",
        "operationId": "update-registration-policy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRegistrationPolicyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated registration policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationPolicy"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users": {
      "get": {
        "summary": "List instance users",
        "operationId": "list-instance-users",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "disabled",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of instance users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceUserList"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/users/{user_id}/disable": {
      "post": {
        "summary": "Disable an instance user",
        "operationId": "disable-instance-user",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceUser"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/admin/v1/users/{user_id}/restore": {
      "post": {
        "summary": "Restore a disabled instance user",
        "operationId": "restore-instance-user",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User restored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceUser"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/admin/v1/config": {
      "get": {
        "summary": "Get instance configuration",
        "operationId": "get-instance-config",
        "responses": {
          "200": {
            "description": "Instance configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update instance configuration",
        "operationId": "update-instance-config",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInstanceConfigRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated instance configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceConfig"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/config/test-email": {
      "post": {
        "summary": "Send a test email to verify SMTP configuration",
        "operationId": "send-test-email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "to"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delivery attempt finished. `success` reports whether the mail was accepted by the SMTP server; a failed attempt is still a 200 so clients receive the machine-readable reason instead of a gateway error page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEmailResult"
                }
              }
            }
          },
          "400": {
            "description": "Recipient address missing or malformed"
          }
        }
      }
    },
    "/admin/v1/organizations": {
      "get": {
        "summary": "List all organizations on this instance",
        "operationId": "list-organizations",
        "responses": {
          "200": {
            "description": "List of organizations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationList"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/health": {
      "get": {
        "summary": "Get instance health summary",
        "operationId": "get-instance-health",
        "responses": {
          "200": {
            "description": "Instance health summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceHealth"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/version": {
      "get": {
        "summary": "Get instance version and update info",
        "operationId": "get-instance-version",
        "responses": {
          "200": {
            "description": "Version info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceVersion"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/features/{capability_key}": {
      "get": {
        "summary": "Resolve a capability gate for the instance",
        "operationId": "get-instance-feature-gate",
        "parameters": [
          {
            "name": "capability_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feature gate decision",
            "headers": {
              "X-OpenToggl-Feature-Gate": {
                "$ref": "./opentoggl-shared.openapi.json#/components/headers/X-OpenToggl-Feature-Gate"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureGateDecision"
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/sso/oidc": {
      "get": {
        "summary": "Read the instance OpenID Connect single sign-on configuration",
        "operationId": "get-instance-oidc-config",
        "responses": {
          "200": {
            "description": "Instance OIDC configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceOidcConfig"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update the instance OpenID Connect single sign-on configuration",
        "operationId": "update-instance-oidc-config",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInstanceOidcConfigRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated instance OIDC configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceOidcConfig"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed; `message` names the field"
          },
          "409": {
            "description": "Stale revision: the configuration was changed by someone else"
          }
        }
      }
    },
    "/admin/v1/sso/oidc/test": {
      "post": {
        "summary": "Run OpenID Connect discovery for an issuer",
        "operationId": "test-instance-oidc-config",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OidcDiscoveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery finished. `ok` reports whether the issuer published usable metadata; a failed discovery is still a 200 so the admin sees the reason.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OidcDiscoveryResult"
                }
              }
            }
          },
          "400": {
            "description": "Issuer URL missing or not https"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeatureGateDecision": {
        "$ref": "./opentoggl-shared.openapi.json#/components/schemas/FeatureGateDecision"
      },
      "TestEmailResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable outcome. Clients localise this; `message` is the raw SMTP detail for diagnostics.",
            "enum": [
              "sent",
              "not_configured",
              "connect_failed",
              "tls_failed",
              "auth_failed",
              "recipient_rejected",
              "timeout",
              "unknown"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "code",
          "message"
        ]
      },
      "BootstrapRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "BootstrapState": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "admin_email": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "RegistrationPolicy": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "invite_only"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "mode",
          "updated_at"
        ]
      },
      "UpdateRegistrationPolicyRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "invite_only"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "InstanceUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "is_instance_admin": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_active_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "is_instance_admin",
          "created_at"
        ]
      },
      "InstanceUserList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstanceUser"
            }
          },
          "total_count": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        },
        "required": [
          "users",
          "total_count",
          "page",
          "per_page"
        ]
      },
      "InstanceHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ]
          },
          "database": {
            "$ref": "#/components/schemas/DependencyHealth"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyHealth"
          },
          "job_backlog": {
            "type": "integer"
          },
          "user_count": {
            "type": "integer"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "database",
          "redis",
          "job_backlog",
          "user_count",
          "checked_at"
        ]
      },
      "InstanceVersion": {
        "type": "object",
        "properties": {
          "current_version": {
            "type": "string"
          },
          "latest_version": {
            "type": "string",
            "nullable": true
          },
          "update_available": {
            "type": "boolean"
          },
          "release_url": {
            "type": "string",
            "nullable": true
          },
          "changelog_url": {
            "type": "string"
          },
          "released_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "announcements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstanceAnnouncement"
            }
          }
        },
        "required": [
          "current_version",
          "update_available",
          "changelog_url",
          "announcements"
        ]
      },
      "InstanceAnnouncement": {
        "type": "object",
        "description": "Announcement sourced from the upstream update worker; surfaced to admins in the overview tab.",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "link": {
            "type": "string",
            "nullable": true
          },
          "body_markdown": {
            "type": "string"
          },
          "translations": {
            "type": "object",
            "description": "Optional per-locale text overrides keyed by BCP-47 base language (e.g. \"zh\"). Additive: clients that ignore this keep rendering the default title/body_markdown.",
            "additionalProperties": {
              "$ref": "#/components/schemas/InstanceAnnouncementTranslation"
            }
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "published_at",
          "body_markdown"
        ]
      },
      "InstanceAnnouncementTranslation": {
        "type": "object",
        "description": "Locale-specific override for an announcement's human-readable fields. Any omitted field falls back to the announcement default.",
        "properties": {
          "title": {
            "type": "string"
          },
          "body_markdown": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DependencyHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latency_ms": {
            "type": "integer"
          }
        },
        "required": [
          "status"
        ]
      },
      "InstanceConfig": {
        "type": "object",
        "properties": {
          "site_url": {
            "type": "string"
          },
          "sender_email": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "smtp_host": {
            "type": "string"
          },
          "smtp_port": {
            "type": "integer"
          },
          "smtp_username": {
            "type": "string"
          },
          "smtp_password": {
            "type": "string"
          },
          "smtp_configured": {
            "type": "boolean"
          },
          "email_verification_required": {
            "type": "boolean"
          },
          "registration_mode": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "invite_only"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "site_url",
          "sender_email",
          "sender_name",
          "smtp_configured",
          "email_verification_required",
          "registration_mode",
          "updated_at"
        ]
      },
      "UpdateInstanceConfigRequest": {
        "type": "object",
        "properties": {
          "site_url": {
            "type": "string"
          },
          "sender_email": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "smtp_host": {
            "type": "string"
          },
          "smtp_port": {
            "type": "integer"
          },
          "smtp_username": {
            "type": "string"
          },
          "smtp_password": {
            "type": "string"
          },
          "email_verification_required": {
            "type": "boolean"
          },
          "registration_mode": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "invite_only"
            ]
          }
        }
      },
      "AdminOrganization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "workspace_count": {
            "type": "integer"
          },
          "member_count": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "workspace_count",
          "member_count"
        ]
      },
      "OrganizationList": {
        "type": "object",
        "properties": {
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminOrganization"
            }
          },
          "total_count": {
            "type": "integer"
          }
        },
        "required": [
          "organizations",
          "total_count"
        ]
      },
      "InstanceOidcConfig": {
        "type": "object",
        "description": "Instance-level OpenID Connect provider plus the derived URLs to register at the provider. The client secret is never returned.",
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "provider_name": {
            "type": "string"
          },
          "issuer_url": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_secret_configured": {
            "type": "boolean"
          },
          "allowed_email_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auto_provision": {
            "type": "boolean"
          },
          "redirect_url": {
            "type": "string",
            "description": "`{site_url}/auth/oidc/callback`; empty until a Site URL is configured."
          },
          "login_url": {
            "type": "string"
          },
          "site_url_configured": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "revision",
          "enabled",
          "provider_name",
          "issuer_url",
          "client_id",
          "client_secret_configured",
          "allowed_email_domains",
          "auto_provision",
          "redirect_url",
          "login_url",
          "site_url_configured",
          "updated_at"
        ]
      },
      "UpdateInstanceOidcConfigRequest": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Optimistic lock: the revision last read. Zero for a fresh instance."
          },
          "enabled": {
            "type": "boolean"
          },
          "provider_name": {
            "type": "string"
          },
          "issuer_url": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "description": "Omit or send empty to keep the stored secret."
          },
          "allowed_email_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auto_provision": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "enabled",
          "provider_name",
          "issuer_url",
          "client_id",
          "allowed_email_domains",
          "auto_provision"
        ]
      },
      "OidcDiscoveryRequest": {
        "type": "object",
        "properties": {
          "issuer_url": {
            "type": "string"
          }
        },
        "required": [
          "issuer_url"
        ]
      },
      "OidcDiscoveryResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
