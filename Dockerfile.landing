# Force the builder stage to run natively on the CI runner arch (amd64 on GH hosted),
# so vp install + framework builds aren't executed under QEMU arm64 emulation (30min+ -> ~3min).
# Output is a plain dist/ (static files), copied into the TARGETPLATFORM runtime image below.
FROM --platform=$BUILDPLATFORM ghcr.io/voidzero-dev/vite-plus:1.4.0 AS builder

USER root
RUN mkdir -p /workspace && chown vp:vp /workspace
USER vp
WORKDIR /workspace

# Copy workspace scaffolding
COPY --chown=vp:vp package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./

# Manifests-first: copy every workspace member's package.json so pnpm can resolve
# the full graph, keeping the install layer cached across source-only edits.
COPY --chown=vp:vp apps/landing/package.json ./apps/landing/
COPY --chown=vp:vp apps/website/package.json ./apps/website/
COPY --chown=vp:vp apps/update-worker/package.json ./apps/update-worker/
COPY --chown=vp:vp packages/web-ui/package.json ./packages/web-ui/
COPY --chown=vp:vp packages/shared-contracts/package.json ./packages/shared-contracts/

RUN vp install --filter @opentickly/landing... --frozen-lockfile --ignore-scripts

COPY --chown=vp:vp apps/landing ./apps/landing
COPY --chown=vp:vp packages ./packages

# react-router's prerender step starts a Vite preview server and reaches it over
# node:http. Under Node 24 the server binds localhost to ::1 while the client
# dials 127.0.0.1, so prerender fails with ECONNREFUSED. Force IPv4-first
# resolution so both ends agree on the loopback address.
ENV NODE_OPTIONS="--dns-result-order=ipv4first"

# The build script runs fumadocs-mdx before react-router build, so it
# regenerates .source itself — no separate postinstall pass needed (install
# ran with --ignore-scripts).
RUN vp run @opentickly/landing#build

# Carry the audited dependency graph into the runtime, including security overrides.
RUN vp exec pnpm --filter @opentickly/landing deploy --prod --legacy --ignore-scripts /workspace/runtime

# ---

FROM node:24-bookworm-slim

WORKDIR /app

COPY --from=builder --chown=node:node /workspace/runtime/node_modules ./node_modules
ENV PATH="/app/node_modules/.bin:${PATH}"

COPY --from=builder --chown=node:node /workspace/apps/landing/dist ./dist
COPY --from=builder --chown=node:node /workspace/apps/landing/serve.json ./dist/serve.json

USER node

EXPOSE 8080

CMD ["sh", "-c", "serve -c serve.json -l ${PORT:-8080} ./dist"]
